Mail\ Body=<\!DOCTYPE html>\n<html>\n<head>\n    <meta charset\="UTF-8">\n    <meta name\="viewport" content\="width\=device-width, initial-scale\=1.0">\n    <title>Integration Error Notification</title>\n</head>\n\n<body style\="margin\:0; padding\:0; background-color\:\#f4f6f9;\n             font-family\:Arial, Helvetica, sans-serif;">\n\n<table width\="100%" cellpadding\="0" cellspacing\="0"\n       border\="0" style\="background-color\:\#f4f6f9; padding\:25px 10px;">\n\n<tr>\n<td align\="center">\n\n<table width\="100%" cellpadding\="0" cellspacing\="0"\n       border\="0"\n       style\="max-width\:760px; background-color\:\#ffffff;\n              border\:1px solid \#e0e0e0;">\n\n    <\!-- Header -->\n    <tr>\n        <td style\="background-color\:\#172554; padding\:25px 30px;\n                   color\:\#ffffff;">\n\n            \n\n            <div style\="font-size\:13px; margin-top\:7px;\n                        color\:\#dbeafe;">\n                SAP Integration Suite \n            </div>\n\n            <div style\="font-size\:17px; font-weight\:bold;\n                        margin-top\:18px;">\n                Integration Flow Failure Notification\n            </div>\n\n        </td>\n    </tr>\n\n    <\!-- Alert Section -->\n    <tr>\n        <td style\="padding\:25px 30px 10px 30px;">\n\n            <div style\="background-color\:\#fff1f0;\n                        border-left\:5px solid \#dc2626;\n                        padding\:15px 18px;">\n\n                <div style\="font-size\:17px; font-weight\:bold;\n                            color\:\#b91c1c;">\n                    &\#9888; Integration Error Detected\n                </div>\n\n                <div style\="font-size\:13px; color\:\#555555;\n                            margin-top\:7px; line-height\:20px;">\n                    An error occurred during integration processing.\n                    Please review the error details below and take\n                    the necessary action.\n                </div>\n\n            </div>\n\n        </td>\n    </tr>\n\n    <\!-- Error Details -->\n    <tr>\n        <td style\="padding\:20px 30px;">\n\n            <div style\="font-size\:17px; font-weight\:bold;\n                        color\:\#172554; margin-bottom\:15px;">\n                Error Details\n            </div>\n\n            <table width\="100%" cellpadding\="10" cellspacing\="0"\n                   border\="0"\n                   style\="border-collapse\:collapse;\n                          font-size\:13px;">\n\n                <tr style\="background-color\:\#f8fafc;">\n                    <td width\="35%" style\="border\:1px solid \#e5e7eb;\n                            font-weight\:bold; color\:\#374151;">\n                        Error Date &amp; Time\n                    </td>\n                    <td style\="border\:1px solid \#e5e7eb;\n                               color\:\#333333;">\n                        ${property.ErrorDateTime}\n                    </td>\n                </tr>\n\n                <tr>\n                    <td style\="border\:1px solid \#e5e7eb;\n                            font-weight\:bold; color\:\#374151;">\n                        Integration Flow\n                    </td>\n                    <td style\="border\:1px solid \#e5e7eb;\n                               color\:\#333333;">\n                        ${property.ErrorFlowID}\n                    </td>\n                </tr>\n\n                <tr style\="background-color\:\#f8fafc;">\n                    <td style\="border\:1px solid \#e5e7eb;\n                            font-weight\:bold; color\:\#374151;">\n                        Message ID\n                    </td>\n                    <td style\="border\:1px solid \#e5e7eb;\n                               color\:\#333333; word-break\:break-all;">\n                        ${property.ErrorMessageID}\n                    </td>\n                </tr>\n\n                <tr>\n                    <td style\="border\:1px solid \#e5e7eb;\n                            font-weight\:bold; color\:\#374151;">\n                        Error Message\n                    </td>\n                    <td style\="border\:1px solid \#e5e7eb;\n                               color\:\#b91c1c;">\n                        ${property.ErrorMessage}\n                    </td>\n                </tr>\n\n                <tr style\="background-color\:\#f8fafc;">\n                    <td style\="border\:1px solid \#e5e7eb;\n                            font-weight\:bold; color\:\#374151;">\n                        Error Response\n                    </td>\n                    <td style\="border\:1px solid \#e5e7eb;\n                               color\:\#333333; word-break\:break-word;">\n                        ${property.ErrorResponse}\n                    </td>\n                </tr>\n\n            </table>\n\n        </td>\n    </tr>\n\n    <\!-- Recommended Action -->\n    <tr>\n        <td style\="padding\:5px 30px 25px 30px;">\n\n            <div style\="background-color\:\#eff6ff;\n                        border-left\:4px solid \#2563eb;\n                        padding\:15px 18px;">\n\n                <div style\="font-size\:14px; font-weight\:bold;\n                            color\:\#1e40af; margin-bottom\:8px;">\n                    Recommended Action\n                </div>\n\n                <div style\="font-size\:13px; color\:\#374151;\n                            line-height\:21px;">\n                    1. Review the integration error details.<br>\n                    2. Check the corresponding message processing log\n                    in SAP Integration Suite.<br>\n                    3. Identify the root cause and take corrective action.<br>\n                    4. Reprocess the failed message, if required.\n                </div>\n\n            </div>\n\n        </td>\n    </tr>\n\n    <\!-- Footer -->\n    <tr>\n        <td style\="background-color\:\#f1f5f9;\n                   padding\:20px 30px;\n                   border-top\:1px solid \#e5e7eb;">\n\n            <div style\="font-size\:13px; color\:\#374151;">\n                Regards,<br>\n                <strong>SAP Integration Support Team</strong>\n            </div>\n\n            <div style\="font-size\:11px; color\:\#888888;\n                        margin-top\:15px; line-height\:18px;">\n                This is an automated notification generated by\n                SAP BTP Integration Suite.<br>\n                Please do not reply to this email.\n            </div>\n\n        </td>\n    </tr>\n\n</table>\n\n</td>\n</tr>\n</table>\n\n</body>\n</html>
