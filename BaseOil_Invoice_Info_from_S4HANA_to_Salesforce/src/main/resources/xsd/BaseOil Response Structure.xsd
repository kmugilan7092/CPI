<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">

    <xs:element name="Envelope">
        <xs:complexType>
            <xs:sequence>

                <xs:element name="Header" minOccurs="0">
                    <xs:complexType>
                        <xs:sequence>
                            <xs:element name="LimitInfoHeader" minOccurs="0">
                                <xs:complexType>
                                    <xs:sequence>
                                        <xs:element name="limitInfo" minOccurs="0" maxOccurs="unbounded">
                                            <xs:complexType>
                                                <xs:sequence>
                                                    <xs:element name="current" type="xs:int"/>
                                                    <xs:element name="limit" type="xs:int"/>
                                                    <xs:element name="type" type="xs:string"/>
                                                </xs:sequence>
                                            </xs:complexType>
                                        </xs:element>
                                    </xs:sequence>
                                </xs:complexType>
                            </xs:element>
                        </xs:sequence>
                    </xs:complexType>
                </xs:element>

                <xs:element name="Body" minOccurs="0">
                    <xs:complexType>
                        <xs:sequence>
                            <xs:element name="createResponse" minOccurs="0">
                                <xs:complexType>
                                    <xs:sequence>
                                        <xs:element name="result" minOccurs="1" maxOccurs="unbounded">
                                            <xs:complexType>
                                                <xs:sequence>
                                                    <xs:element name="errors" minOccurs="0">
                                                        <xs:complexType>
                                                            <xs:sequence>
                                                                <xs:element name="fields" type="xs:string" minOccurs="0" maxOccurs="unbounded"/>
                                                                <xs:element name="message" type="xs:string" minOccurs="0"/>
                                                                <xs:element name="statusCode" type="xs:string" minOccurs="0"/>
                                                            </xs:sequence>
                                                        </xs:complexType>
                                                    </xs:element>

                                                    <xs:element name="id" type="xs:string" nillable="true"/>
                                                    <xs:element name="success" type="xs:boolean" minOccurs="0"/>
                                                </xs:sequence>
                                            </xs:complexType>
                                        </xs:element>
                                    </xs:sequence>
                                </xs:complexType>
                            </xs:element>
                        </xs:sequence>
                    </xs:complexType>
                </xs:element>

            </xs:sequence>
        </xs:complexType>
    </xs:element>

</xs:schema>
